# Banco SQLite local (Prisma) — funciona sem configuração externa
DATABASE_URL="file:./prisma/dev.db"

# Segredo para sessões JWT (obrigatório em produção, mínimo 32 caracteres)
AUTH_SECRET="troque-por-um-segredo-longo-e-aleatorio-com-32-chars-min"

# Supabase (opcional — para migração futura)
# NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# E-mail de convites (opcional — Resend)
# RESEND_API_KEY=re_...
# EMAIL_FROM=Ecohub <noreply@suaescola.com.br>
# NEXT_PUBLIC_APP_URL=https://seu-dominio.com

# Administração da plataforma (e-mails separados por vírgula)
# PLATFORM_ADMIN_EMAILS=admin@ecohub.local

# Domínio raiz para portais por subdomínio (opcional)
# NEXT_PUBLIC_ROOT_DOMAIN=ecohub.app.br
