{
  "name": "projeto-estudante",
  "version": "0.1.0",
  "prisma": {
    "seed": "tsx scripts/seed-pilot-institution.ts"
  },
  "scripts": {
    "dev": "next dev",
    "setup:local": "node scripts/setup-local.mjs",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "check": "npm run lint && npm run build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:scroll": "node scripts/verify-scroll-layout.mjs",
    "test:validation": "npx tsx scripts/institutional-validation.ts",
    "test:full": "node scripts/run-full-validation.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:reset-user": "node scripts/reset-user-by-email.mjs",
    "db:pilot": "npx tsx scripts/seed-pilot-institution.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-pilot-institution.ts",
    "db:reset": "node scripts/guard-destructive-db.mjs && prisma migrate reset --force",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "html-to-docx": "^1.8.0",
    "jose": "^6.2.8",
    "lucide-react": "^1.29.0",
    "mammoth": "^1.12.2",
    "next": "16.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
