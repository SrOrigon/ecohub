{
  "name": "projeto-estudante",
  "version": "0.1.0",
  "prisma": {
    "seed": "tsx scripts/seed-pilot-institution.ts"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-generate.mjs && next build",
    "start": "node scripts/start-production.mjs",
    "lint": "eslint",
    "check": "npm run lint && npm run build",
    "test:smoke": "node scripts/smoke-test.mjs",
    "test:validation": "npx tsx scripts/institutional-validation.ts",
    "test:full": "node scripts/run-full-validation.mjs",
    "db:backup": "node scripts/backup-db.mjs",
    "db:reset-user": "node scripts/reset-user-by-email.mjs",
    "db:pilot": "npx tsx scripts/seed-pilot-institution.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx scripts/seed-pilot-institution.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "node scripts/prisma-generate.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.7.1",
    "@prisma/client": "^5.22.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tanstack/react-table": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "jose": "^6.2.8",
    "lucide-react": "^1.29.0",
    "next": "16.3.0",
    "prisma": "^5.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.84.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "tsx": "^4.23.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
