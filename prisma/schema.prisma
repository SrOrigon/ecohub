generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model School {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String?
  state     String?
  settings  String   @default("{}")
  createdAt DateTime @default(now())

  users       User[]
  classGroups ClassGroup[]
  missions    Mission[]
  badges      Badge[]
  rewards     Reward[]
  rewardCategories RewardCategory[]
  exercises   Exercise[]
  trails      LearningTrail[]
  announcements Announcement[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  fullName     String
  role         String   @default("student")
  avatarUrl    String?
  schoolId     String?
  createdAt    DateTime @default(now())

  school         School?      @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  student        Student?
  taughtClasses  ClassGroup[] @relation("ClassTeacher")
  gradesGiven    Grade[]          @relation("GradeTeacher")
  exercisesCreated Exercise[]     @relation("ExerciseTeacher")
  exercisesGraded  ExerciseSubmission[] @relation("ExerciseGrader")
  sessions       Session[]
  parentLinks    ParentStudent[]  @relation("ParentUser")
  notifications  Notification[]
  homeTasksCreated HomeTask[]     @relation("HomeTaskParent")
  diaryEntries   ClassDiaryEntry[]
  occurrences    Occurrence[]     @relation("OccurrenceTeacher")
  announcements  Announcement[]
  announcementReads AnnouncementRead[]
  personalNotes  UserNote[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String
  href      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
}

model ClassGroup {
  id         String   @id @default(cuid())
  schoolId   String
  name       String
  gradeLevel String
  year       Int      @default(2026)
  teacherId  String?
  createdAt  DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher     User?        @relation("ClassTeacher", fields: [teacherId], references: [id], onDelete: SetNull)
  students    Student[]
  attendance  Attendance[]
  missions    Mission[]
  exercises   Exercise[]
  diaryEntries ClassDiaryEntry[]
  occurrences Occurrence[]
  trails      LearningTrail[]
  classGoals  ClassGoal[]
  announcements Announcement[]

  @@index([schoolId])
}

model Student {
  id             String   @id @default(cuid())
  userId         String   @unique
  enrollmentCode String   @unique
  birthDate      DateTime?
  classId        String?
  xpTotal        Int      @default(0)
  level          Int      @default(1)
  coins          Int      @default(0)
  createdAt      DateTime @default(now())

  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classGroup      ClassGroup?       @relation(fields: [classId], references: [id], onDelete: SetNull)
  grades          Grade[]
  attendance      Attendance[]
  xpTransactions  XpTransaction[]
  studentMissions   StudentMission[]
  studentBadges     StudentBadge[]
  rewardRedemptions RewardRedemption[]
  parentLinks       ParentStudent[]
  exerciseSubmissions ExerciseSubmission[]
  trailProgress     StudentTrailProgress[]
  occurrences       Occurrence[]
  homeTasks         HomeTask[]

  @@index([classId])
}

model Grade {
  id        String   @id @default(cuid())
  studentId String
  subject   String
  value     Float
  maxValue  Float    @default(10)
  period    String
  teacherId String?
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacher User?   @relation("GradeTeacher", fields: [teacherId], references: [id], onDelete: SetNull)

  @@index([studentId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  status    String   @default("present")
  createdAt DateTime         @default(now())

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, date])
  @@index([classId, date])
}

model Mission {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String?
  title       String
  description String?
  xpReward    Int       @default(0)
  coinReward  Int       @default(0)
  dueDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  school          School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup      ClassGroup?      @relation(fields: [classId], references: [id], onDelete: SetNull)
  studentMissions StudentMission[]
  trailSteps      TrailStep[]

  @@index([schoolId])
}

model StudentMission {
  id          String    @id @default(cuid())
  studentId   String
  missionId   String
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  @@unique([studentId, missionId])
}

model Badge {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  icon        String   @default("star")
  xpRequired  Int      @default(0)
  createdAt   DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  studentBadges StudentBadge[]
}

model StudentBadge {
  id        String   @id @default(cuid())
  studentId String
  badgeId   String
  earnedAt  DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  badge   Badge   @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([studentId, badgeId])
}

model XpTransaction {
  id        String   @id @default(cuid())
  studentId String
  amount    Int
  reason    String
  source    String
  createdAt DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model RewardCategory {
  id          String   @id @default(cuid())
  schoolId    String
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school  School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  rewards Reward[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Reward {
  id          String   @id @default(cuid())
  schoolId    String
  categoryId  String?
  name        String
  description String?
  coinCost    Int
  stock       Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  category    RewardCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  redemptions RewardRedemption[]
  trailSteps  TrailStep[]

  @@index([categoryId])
}

model RewardRedemption {
  id          String    @id @default(cuid())
  studentId   String
  rewardId    String
  coinCost    Int
  status      String    @default("pending")
  redeemedAt  DateTime  @default(now())
  fulfilledAt DateTime?

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  reward  Reward  @relation(fields: [rewardId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([status])
}

model ParentStudent {
  id        String   @id @default(cuid())
  parentId  String
  studentId String
  relation  String   @default("responsavel")
  createdAt DateTime @default(now())

  parent  User    @relation("ParentUser", fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

model Exercise {
  id          String    @id @default(cuid())
  schoolId    String
  classId     String?
  teacherId   String
  title       String
  description String?
  kind        String    @default("homework")
  maxPoints   Float     @default(10)
  xpReward    Int       @default(0)
  coinReward  Int       @default(0)
  dueDate     DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  school       School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup   ClassGroup?          @relation(fields: [classId], references: [id], onDelete: SetNull)
  teacher      User                 @relation("ExerciseTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  questions    ExerciseQuestion[]
  submissions  ExerciseSubmission[]
  trailSteps   TrailStep[]

  @@index([schoolId])
  @@index([classId])
  @@index([teacherId])
}

model ExerciseQuestion {
  id         String  @id @default(cuid())
  exerciseId String
  prompt     String
  type       String  @default("choice")
  options    String?
  points     Float   @default(1)
  sortOrder  Int     @default(0)

  exercise Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  answers  ExerciseAnswer[]

  @@index([exerciseId])
}

model ExerciseSubmission {
  id          String    @id @default(cuid())
  exerciseId  String
  studentId   String
  status      String    @default("submitted")
  score       Float?
  maxScore    Float?
  feedback    String?
  submittedAt DateTime  @default(now())
  gradedAt    DateTime?
  gradedById  String?

  exercise Exercise         @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  student  Student          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  grader   User?            @relation("ExerciseGrader", fields: [gradedById], references: [id], onDelete: SetNull)
  answers  ExerciseAnswer[]

  @@unique([exerciseId, studentId])
  @@index([exerciseId])
  @@index([studentId])
}

model ExerciseAnswer {
  id               String  @id @default(cuid())
  submissionId     String
  questionId       String
  textAnswer       String?
  selectedOptionId String?
  pointsAwarded    Float?
  isCorrect        Boolean?

  submission ExerciseSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   ExerciseQuestion   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
}

model ClassDiaryEntry {
  id        String   @id @default(cuid())
  classId   String
  teacherId String
  date      DateTime
  subject   String?
  content   String
  createdAt DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher    User       @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId, date])
}

model Occurrence {
  id          String   @id @default(cuid())
  classId     String
  studentId   String?
  teacherId   String
  kind        String   @default("observation")
  description String
  date        DateTime @default(now())
  createdAt   DateTime @default(now())

  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    Student?   @relation(fields: [studentId], references: [id], onDelete: SetNull)
  teacher    User       @relation("OccurrenceTeacher", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([classId, date])
  @@index([studentId])
}

model LearningTrail {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String?
  title       String
  description String?
  xpBonus     Int      @default(0)
  coinBonus   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  school   School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  steps    TrailStep[]
  progress StudentTrailProgress[]

  @@index([schoolId])
}

model TrailStep {
  id         String  @id @default(cuid())
  trailId    String
  sortOrder  Int     @default(0)
  stepType   String
  missionId  String?
  exerciseId String?
  rewardId   String?
  title      String?

  trail    LearningTrail @relation(fields: [trailId], references: [id], onDelete: Cascade)
  mission  Mission?      @relation(fields: [missionId], references: [id], onDelete: SetNull)
  exercise Exercise?     @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  reward   Reward?       @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([trailId])
}

model StudentTrailProgress {
  id          String    @id @default(cuid())
  studentId   String
  trailId     String
  currentStep Int       @default(0)
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  student Student       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  trail   LearningTrail @relation(fields: [trailId], references: [id], onDelete: Cascade)

  @@unique([studentId, trailId])
}

model Announcement {
  id          String   @id @default(cuid())
  schoolId    String
  classId     String?
  authorId    String
  title       String
  body        String
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  school     School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classGroup ClassGroup?        @relation(fields: [classId], references: [id], onDelete: SetNull)
  author     User               @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reads      AnnouncementRead[]

  @@index([schoolId, publishedAt])
}

model AnnouncementRead {
  id             String   @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime @default(now())

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
}

model ClassGoal {
  id            String    @id @default(cuid())
  classId       String
  title         String
  metric        String    @default("mission")
  targetPercent Int       @default(80)
  xpBonus       Int       @default(100)
  coinBonus     Int       @default(50)
  deadline      DateTime?
  isActive      Boolean   @default(true)
  awardedAt     DateTime?
  createdAt     DateTime  @default(now())

  classGroup ClassGroup @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

model HomeTask {
  id          String    @id @default(cuid())
  studentId   String
  parentId    String
  title       String
  description String?
  xpReward    Int       @default(100)
  coinReward  Int       @default(10)
  status      String    @default("pending")
  dueDate     DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  parent  User    @relation("HomeTaskParent", fields: [parentId], references: [id], onDelete: Cascade)

  @@index([studentId, status])
  @@index([parentId])
}

model UserNote {
  id        String    @id @default(cuid())
  userId    String
  title     String?
  content   String
  date      DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
  @@index([userId, createdAt])
}
